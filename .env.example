# Copy to .env.local and fill in. .env.local is gitignored.
#
# Both values come from YOUR own Supabase project (free tier is fine):
#   Dashboard → Project Settings → API
#   https://supabase.com/dashboard/project/<your-ref>/settings/api
#
# The publishable (anon) key is safe to expose in the client bundle — RLS
# does the gating. Never put the service-role key, JWT_PRIVATE_KEY, or the
# Anthropic key here; those live in Supabase Function secrets only.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
