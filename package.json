{
  "name": "wasteland-queen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Coordination tool for the Wasteland King event in Puzzles & Survival — public sign-up, an auto-sorting drag-and-drop planner, and a shareable read-only board.",
  "license": "MIT",
  "homepage": "https://waqu.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/HoiPolloi-labs/WastelandQueen.git"
  },
  "bugs": {
    "url": "https://github.com/HoiPolloi-labs/WastelandQueen/issues"
  },
  "keywords": [
    "puzzles-and-survival",
    "wasteland-king",
    "react",
    "vite",
    "supabase",
    "alliance-tool"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "optimize:images": "node scripts/optimize-hero-images.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.106.2",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router": "^7.18.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0-beta.8",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "happy-dom": "^20.9.0",
    "prettier": "^3.4.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0-beta.8",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
